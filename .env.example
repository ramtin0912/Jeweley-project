# Copy to .env and fill in. Never commit .env.

# Database (PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/jewelry_store?schema=public"

# Zarinpal (payment gateway)
ZARINPAL_MERCHANT_ID=""
# true = sandbox (test), false = live
ZARINPAL_SANDBOX="true"

# Kavenegar (SMS OTP)
KAVENEGAR_API_KEY=""
KAVENEGAR_OTP_TEMPLATE="orderverify"

# Admin session signing secret (generate with: openssl rand -hex 32)
ADMIN_SESSION_SECRET=""
