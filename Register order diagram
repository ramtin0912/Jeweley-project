@startuml
title نمودار فعالیت ثبت سفارش و پرداخت آنلاین

start

:ورود مشتری به فروشگاه;
:مشاهده محصولات;
:انتخاب محصول;
:مشاهده جزئیات محصول;

if (آیا مشتری قصد خرید دارد؟) then (بله)

    :ثبت اطلاعات سفارش;
    :محاسبه مبلغ سفارش;
    :نمایش مبلغ نهایی;

    :انتقال به درگاه پرداخت;

    if (نتیجه پرداخت چیست؟) then (موفق)

        :ثبت نتیجه پرداخت موفق;
        :نمایش پیام موفقیت;

    else (ناموفق یا لغو شده)

        :نمایش نتیجه پرداخت;

        if (تلاش مجدد؟) then (بله)
            :بازگشت به مرحله پرداخت;
            :انتقال مجدد به درگاه پرداخت;

            if (پرداخت مجدد موفق است؟) then (بله)
                :ثبت نتیجه پرداخت موفق;
                :نمایش پیام موفقیت;
            else (خیر)
                :نمایش پیام پرداخت ناموفق;
            endif

        else (خیر)
            :پایان فرایند بدون پرداخت موفق;
        endif

    endif

else (خیر)
    :بازگشت به فهرست محصولات;
endif

stop
@enduml
